# BetPawa Betting Assistant Configuration
# Copy this file to .env and fill in your actual values

# Database settings
DATABASE_PATH=betting_assistant.db

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=betting_assistant.log

# BetPawa settings (NO PASSWORDS - manual authentication only)
BETPAWA_URL=https://www.betpawa.ug
DEFAULT_STAKE=5000
DEFAULT_MIN_ODDS=1.20
DEFAULT_MAX_ODDS=3.00
DEFAULT_MIN_PAYOUT=50000

# Selection limits
DEFAULT_MAX_MATCHES=5
DEFAULT_MAX_COMBINATIONS=10

# Probability filter (market-implied win probability, 0-1)
DEFAULT_MIN_WIN_PROB=0.60
MAX_LEGS=8
POOL_SIZE=20

# Browser: false = visible Chrome (recommended), true = headless
HEADLESS=false
DEBUG_DIR=debug

# Lazy-load scrolling
SCROLL_LOAD_WAIT=6
SCROLL_MAX_STALLS=3
SCROLL_MAX_STEPS=150
MAX_FIXTURES=400
LIVE_MAX_LEGS=60
LIVE_PACE=true

# Double Chance page (this is the default; only set it if BetPawa changes the address)
# DC_MARKET_URL=https://www.betpawa.ug/events?categoryId=2&marketId=Double%20Chance
